<div id="app">
  <div class="max-w-6xl mx-auto px-5 md:px-8 py-10 md:py-12">
    <div class="flex items-end gap-4 mb-7">
      <h1 class="font-black text-ink text-4xl md:text-5xl leading-none">購物車</h1>
      <span v-if="items.length" class="text-ink-soft font-medium pb-1">{{ items.length }} 件商品</span>
    </div>

    <div v-if="loading" class="flex justify-center py-16">
      <div class="w-8 h-8 border-4 border-terra border-t-transparent rounded-full animate-spin"></div>
    </div>

    <div v-else-if="items.length === 0" class="text-center py-16">
      <div class="text-5xl mb-3">🛒</div>
      <p class="text-ink font-semibold mb-1">購物車是空的</p>
      <p class="text-ink-soft text-sm mb-5">快去挑選喜歡的花束吧！</p>
      <a href="/" class="inline-block bg-ink text-paper font-bold px-7 py-3 rounded-full hover:bg-terra transition-colors">去逛逛</a>
    </div>

    <template v-else>
      <!-- Free shipping banner -->
      <div v-if="total < 1500" class="bg-leaf text-ink rounded-2xl px-6 py-4 mb-6 font-bold flex items-center gap-3">
        <span>🚚</span> 再買 NT$ {{ (1500 - total).toLocaleString() }} 即可免宅配基本運費！
      </div>
      <div v-else class="bg-leaf text-ink rounded-2xl px-6 py-4 mb-6 font-bold flex items-center gap-3">
        <span>✓</span> 已達宅配基本運費免除門檻！（附加費另計）
      </div>

      <div class="flex flex-col lg:flex-row gap-8 items-start">
        <!-- Cart Items -->
        <div class="w-full lg:flex-1 bg-white rounded-3xl border-2 border-ink overflow-hidden">
          <div
            v-for="(item, idx) in items"
            :key="item.id"
            class="flex items-center gap-4 p-5"
            :class="{ 'border-b-2 border-line': idx < items.length - 1 }"
          >
            <img
              :src="item.product.image_url || 'https://images.unsplash.com/photo-1490750967868-88aa4f44baee?w=200'"
              :alt="item.product.name"
              class="w-20 h-20 rounded-xl object-cover flex-shrink-0 border border-line"
            />
            <div class="flex-1 min-w-0">
              <h3 class="font-bold text-ink truncate">{{ item.product.name }}</h3>
              <p class="text-ink-soft text-sm mt-0.5">NT$ {{ item.product.price.toLocaleString() }}</p>
            </div>

            <div class="flex items-center border-2 border-line rounded-full overflow-hidden">
              <button
                @click="updateQuantity(item.id, item.quantity - 1)"
                :disabled="item.quantity <= 1"
                class="w-9 h-9 flex items-center justify-center hover:bg-paper-2 font-display text-lg disabled:opacity-40"
              >−</button>
              <span class="w-9 h-9 flex items-center justify-center text-sm font-bold">{{ item.quantity }}</span>
              <button
                @click="updateQuantity(item.id, item.quantity + 1)"
                :disabled="item.quantity >= item.product.stock"
                class="w-9 h-9 flex items-center justify-center hover:bg-paper-2 font-display text-lg disabled:opacity-40 disabled:cursor-not-allowed"
              >+</button>
            </div>

            <p class="font-bold text-ink w-24 text-right hidden sm:block">
              NT$ {{ (item.product.price * item.quantity).toLocaleString() }}
            </p>

            <button @click="confirmDelete(item.id)" class="text-ink-soft hover:text-terra transition-colors ml-1">✕</button>
          </div>
        </div>

        <!-- Summary -->
        <div class="w-full lg:w-96 bg-ink rounded-3xl p-7 text-paper">
          <h2 class="font-bold text-lg mb-5">訂單摘要</h2>
          <div class="flex justify-between items-center mb-3 text-sm">
            <span class="text-[#B8AFA2]">商品小計</span>
            <span>NT$ {{ total.toLocaleString() }}</span>
          </div>
          <div class="flex justify-between items-center mb-4 text-sm">
            <span class="text-[#B8AFA2]">預估宅配基本運費</span>
            <span>{{ total >= 1500 ? '免基本運費' : 'NT$ 120' }}</span>
          </div>
          <div class="border-t border-forest-2 pt-4 flex justify-between items-center">
            <span class="font-bold">總計</span>
            <span class="font-display font-extrabold text-3xl text-leaf">
              NT$ {{ (total + (total >= 1500 ? 0 : 120)).toLocaleString() }}
            </span>
          </div>
          <button
            @click="goCheckout"
            class="w-full mt-6 bg-terra text-white font-bold py-4 rounded-full hover:bg-terra-deep transition-colors"
          >前往結帳&nbsp;&nbsp;→</button>
        </div>
      </div>
    </template>

    <!-- Confirm Dialog -->
    <div v-if="confirmVisible" class="fixed inset-0 z-50 flex items-center justify-center">
      <div class="absolute inset-0 bg-black/50" @click="confirmVisible = false"></div>
      <div class="relative bg-white rounded-3xl border-2 border-ink w-full max-w-sm mx-4 p-7 text-center">
        <h3 class="text-lg font-black text-ink mb-2">確認移除</h3>
        <p class="text-ink-soft text-sm mb-6">確定要從購物車中移除這個商品嗎？</p>
        <div class="flex gap-3 justify-center">
          <button @click="confirmVisible = false" class="px-5 py-2.5 text-sm font-bold rounded-full border-2 border-line text-ink hover:bg-paper-2">取消</button>
          <button @click="handleDelete" class="px-5 py-2.5 text-sm font-bold rounded-full bg-terra text-white hover:bg-terra-deep">確認移除</button>
        </div>
      </div>
    </div>
  </div>
</div>
